# Spark C2 pilot stack — copy to .env

MODELS_HOST_PATH=/home/mylearningbuddy/opt/models
HF_ENDPOINT=https://hf-mirror.com

# vLLM Marlin (GB10)
VLLM_USE_FLASHINFER_MOE_FP4=0
VLLM_NVFP4_GEMM_BACKEND=marlin
VLLM_TEST_FORCE_FP8_MARLIN=0
FLASHINFER_DISABLE_VERSION_CHECK=1
CUTE_DSL_ARCH=sm_121a
VLLM_BASE_URL=http://vllm-qwen36-35b:8088/v1
VLLM_MODEL=qwen38-27b-nvfp4
VLLM_MAX_CONCURRENT=2
VLLM_TEMPERATURE=0
# LAN OpenAI proxy on C2 :8000/v1 → vLLM (WSL WTR). Required when enabled.
VLLM_LAN_PROXY_ENABLED=true
VLLM_LAN_TOKEN=change-me-vllm-lan
VLLM_LAN_TIMEOUT_S=600

# PostgreSQL
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy
DATABASE_URL=postgresql+psycopg://buddy:buddy@postgres:5432/buddy

# Redis / Qdrant / MinIO
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MILVUS_COLLECTION=lb_corpus
MILVUS_STAGING_COLLECTION=lb_corpus_staging

# Buddy API pilot auth (≤5 students)
MAX_STUDENTS=5
ADMIN_TOKEN=change-me-admin
# Studio UI → gateway `/api/v1/studio/*`（浏览器持有；勿与局域网无关方共享）
STUDIO_TOKEN=change-me-admin

# Buddy Copilot（宿主机 :8200，Cursor SDK 编排服务；见 buddy-copilot/README.md）
# c2-gateway 经 host.docker.internal 访问；令牌复用 ADMIN_TOKEN
COPILOT_BASE_URL=http://host.docker.internal:8200
API_TOKEN=change-me-api

# RAG / Agent
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_HYBRID_ALPHA=0.7
KP_SCORE_THRESHOLD=0.55
GRAPH_ENABLED=true
EVAL_AGENT_ENABLED=true
EVAL_FALLBACK_RULES=true
EVAL_USE_BANK_ANSWER=false
EVAL_SOLVE_THINKING=true
EVAL_TWO_PHASE_SOLVE=true
EVAL_HINTS_MAX_PER_SECTION=2
EVAL_DEBUG_TRACE=true
EVAL_DEBUG_LOG=true
EVAL_LOG_TO_FILE=true
EVAL_LOG_DIR=/data/buddy/logs/eval
REFINE_ENABLED=true

# Milvus + NeMo Retriever (M2)
VECTOR_BACKEND=milvus
NGC_API_KEY=
NEMO_EMBED_ENABLED=true
NEMO_RERANK_ENABLED=true
EMBED_DEVICE=cuda
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DIM=2048
RAG_TOP_K=30
RAG_RERANK_TOP_K=5

# LAN
C2_BASE_URL=http://192.168.1.10:8000

# Textbook File Agent (独立服务 :8200，宿主机映射 8210 以免占 buddy-copilot :8200)
TEXTBOOK_AGENT_URL=http://textbook-agent:8200
TEXTBOOK_AGENT_TOKEN=change-me-textbook-agent
TEXTBOOK_AGENT_TIMEOUT_S=1800
CURSOR_EVAL_TIMEOUT_S=1800
CURSOR_SEND_TIMEOUT_S=180
AGENT_HOME=/data/agent
CURSOR_API_KEY=
CURSOR_MODEL=grok-4.6
CURSOR_MODEL_EFFORT=high
CURSOR_MODEL_FAST=true
CURSOR_TASK_MODEL=grok-4.6
CURSOR_TASK_EFFORT=high
CURSOR_TASK_FAST=true
# textbook-agent 容器走文件凭证（无钥匙串），见 compose AGENT_CLI_CREDENTIAL_STORE=file
# 只放 API key；容器里禁止保留 accessToken/refreshToken（过期会话会盖掉仍有效的钥匙）
# 一座本地桥同时只发 1 路；多开对话排队。不要开回 4，除非改成隔离工作区。
MAX_CONCURRENT_SENDS=1
