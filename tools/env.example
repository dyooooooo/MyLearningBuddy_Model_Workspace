# DGX Spark AI Lab — environment variables
# Mirror env vars are in ~/.bashrc.d/china-mirrors.sh (via tools/setup-china-mirrors.sh)
# Copy API key lines you need into ~/.bashrc.d/dgx-spark-env.sh, then: source ~/.bashrc
#
# Cursor workspace root: ~/MyLearningBuddy_Model_Workspace/

# Context7 MCP — higher rate limits (optional)
# Get key: https://context7.com/dashboard
export CONTEXT7_API_KEY=""

# GitHub MCP — repo/PR automation (optional)
# Create PAT: https://github.com/settings/tokens
export GITHUB_PERSONAL_ACCESS_TOKEN=""

# NGC — pull private/gated containers
# Get key: https://org.ngc.nvidia.com/setup/api-key
export NGC_API_KEY=""

# Hugging Face — download gated models
# Get token: https://huggingface.co/settings/tokens
export HF_TOKEN=""

# Cursor SDK — programmatic agents (optional)
export CURSOR_API_KEY=""
