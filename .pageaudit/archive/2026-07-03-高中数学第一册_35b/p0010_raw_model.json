      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "数学中，常常需要用到数的集合. 数的集合简称数集. 常用的数集可用以下特定的符号来表示，见表 1-1."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
