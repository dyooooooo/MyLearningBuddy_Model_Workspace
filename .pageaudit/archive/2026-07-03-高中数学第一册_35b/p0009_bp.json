      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "一个给定集合中的各个元素是互不相同的，即一个元素在同一个集合中是不能重复出现的."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null,
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": null
