      ],
      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "半开半闭区间在数轴上的表示，如图 1-1-2 所示."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p12_f2",
      "kind": "figure",
      "zone": "main",
      "role": "figure",
      "bbox": [
