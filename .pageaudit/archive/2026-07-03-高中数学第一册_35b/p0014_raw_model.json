          "paragraphs": [
            "分别解得 $\\begin{cases} x=2, \\\\ y=6 \\end{cases}$ 或 $\\begin{cases} x=4, \\\\ y=0.$"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p14_b9",
      "kind": "text",
