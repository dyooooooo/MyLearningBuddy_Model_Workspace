        530
      ],
      "anchor_id": "p14_b5",
      "figure_group_id": null,
      "content": {
        "text": null,
        "table": null,
        "equation": {
          "latex": "\\mathbf{N} \\subset \\mathbf{Z} \\subset \\mathbf{Q} \\subset \\mathbf{R}",
          "fallback_text": "N ⊂ Z ⊂ Q ⊂ R"
