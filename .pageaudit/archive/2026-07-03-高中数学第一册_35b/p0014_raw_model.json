      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "例 6 确定 $x$ 与 $y$，使得集合 $\\{2x, x+y\\} = \\{4, 8\\}$."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p14_b7",
      "kind": "text",
      "zone": "main",
      "role": "example",
      "bbox": [
        135,
        565,
        400,
        590
      ],
      "anchor_id": "p14_b6",
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "解 由集合相等的定义，可知"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p14_eq2",
      "kind": "equation",
      "zone": "main",
      "role": "equation",
      "bbox": [
        265,
        595,
        485,
        630
      ],
      "anchor_id": "p14_b7",
      "figure_group_id": null,
      "content": {
        "text": null,
        "table": null,
        "equation": {
          "latex": "\\begin{cases} 2x=4, \\\\ x+y=8 \\end{cases} \\text{ 或 } \\begin{cases} 2x=8, \\\\ x+y=4. \\end{cases}",
          "fallback_text": "2x=4, x+y=8 或 2x=8, x+y=4"
        },
        "figure": null
      }
    },
    {
      "id": "p14_b8",
      "kind": "text",
      "zone": "main",
      "role": "example",
      "bbox": [
