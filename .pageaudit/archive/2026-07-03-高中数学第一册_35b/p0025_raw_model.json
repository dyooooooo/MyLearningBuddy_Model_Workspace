      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "例 7 证明：$\\sqrt{2}$ 是无理数。"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p25_b8",
      "kind": "text",
      "zone": "main",
      "role": "example",
      "bbox": [
        330,
        245,
        910,
        265
      ],
      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "证明 用反证法证明。"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
