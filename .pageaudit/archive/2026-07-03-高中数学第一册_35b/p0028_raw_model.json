      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "8. 设 $a$ 是实数。若 $x=1$ 是 $x>a$ 的一个充分条件，则 $a$ 的取值范围为________。"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
