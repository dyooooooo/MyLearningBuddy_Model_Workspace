      "content": {
        "text": {
          "paragraphs": [
            "5. 已知集合 $A=(-2,1)$，$B=(-\\infty,-2) \\cup [1,+\\infty)$。求：$A \\cup B$，$A \\cap B$。"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
