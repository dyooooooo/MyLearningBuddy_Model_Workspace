      "content": {
        "text": {
          "paragraphs": [
            "6. 已知全集 $U=(-\\infty,1) \\cup [2,+\\infty)$，集合 $A=(-1,1) \\cup [3,+\\infty)$。求 $\\overline{A}$。"
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
