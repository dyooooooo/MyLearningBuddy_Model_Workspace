      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "8. 已知集合 $A=\\{(x, y) \\mid y=-x+1\\}$，$B=\\{(x, y) \\mid y=x^{2}-1\\}$. 求 $A \\cap B$."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
