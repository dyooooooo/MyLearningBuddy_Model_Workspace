      "content": {
        "text": {
          "paragraphs": [
            "9. 已知全集 $U=\\mathbf{R}$，集合 $A=\\{x \\mid 4-x>2 x+1\\}$. 求 $\\overline{A}$."
          ]
        },
        "table": null,
