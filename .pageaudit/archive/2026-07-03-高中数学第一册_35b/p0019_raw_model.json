      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "7. 已知集合 $A=\\{x \\mid x \\leqslant 7\\}$，$B=\\{x \\mid x<2\\}$，$C=\\{x \\mid x>5\\}$. 求：$A \\cap B$，$A \\cap C$，$A \\cap(B \\cap C)$."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
