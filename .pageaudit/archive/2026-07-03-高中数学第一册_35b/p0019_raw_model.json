        "text": {
          "paragraphs": [
            "B. 第三象限内的所有点组成的集合；",
            "C. 第一象限和第三象限内的所有点组成的集合；",
            "D. 不在第二象限也不在第四象限内的所有点组成的集合."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
