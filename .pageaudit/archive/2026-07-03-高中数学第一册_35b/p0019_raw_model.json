      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": {
          "paragraphs": [
            "6. 已知集合 $A=\\{x, y\\}$，$B=\\{2 x, 2 x^{2}\\}$，且 $A=B$. 求集合 $A$."
          ]
        },
        "table": null,
        "equation": null,
        "figure": null
      }
    },
    {
      "id": "p19_b5",
      "kind": "text",
      "zone": "main",
      "role": "exercise",
      "bbox": [
        145,
        305,
        920,
        345
