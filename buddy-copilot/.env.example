# Buddy Copilot 宿主机编排服务配置（复制为 .env 后填写）

# Cursor SDK —— 必填。从 https://cursor.com/dashboard/integrations 获取
CURSOR_API_KEY=

# Cursor Agent 模型（钉扎，保证行为可复现）
CURSOR_MODEL=auto

# 监听地址：须绑 0.0.0.0 才能被 c2-gateway 容器经 host.docker.internal 访问；
# 除 health 外所有接口要求 Bearer ADMIN_TOKEN，勿裸奔到不可信网络
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8200

# 工作区根目录（Agent 的 cwd）
WORKSPACE_ROOT=/home/mylearningbuddy/MyLearningBuddy_Model_Workspace

# buddy-api 管理端（宿主机口）
BUDDY_API_BASE=http://127.0.0.1:8100
# c2-gateway 地址（minio.stat 对象预检走网关）
GATEWAY_BASE=http://127.0.0.1:8000
# 管理令牌：留空则自动从 learning-buddy-c2/.env 读取 ADMIN_TOKEN
ADMIN_TOKEN=

# 会话数据库
COPILOT_DB_PATH=data/copilot.db

# 闭环迭代上限（L4 验收不通过时最多自动重试轮数）
MAX_LOOP_ITERATIONS=3

# Agent 单轮最长运行秒数
AGENT_RUN_TIMEOUT=900

# ---- 三角裁决（全书预览）----
# 本地 vLLM（35B 主力）；模型名与 /v1/models 一致
VLLM_BASE_URL=http://127.0.0.1:8088/v1
VLLM_MODEL=qwen36-35b-nvfp4
# VLLM_API_TOKEN=

# MinerU 锚点：structural=快；auto=有 Token 走 Cloud；cloud=强制 Cloud
# Token 留空则自动读 learning-buddy-c2/.env 的 MINERU_API_TOKEN
LAYOUT_ANCHOR_MODE=structural
# MINERU_API_TOKEN=
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_TIMEOUT_S=180
