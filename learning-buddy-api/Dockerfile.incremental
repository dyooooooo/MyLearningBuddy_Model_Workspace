# Fast incremental build: reuse existing buddy-api image (torch/deps already baked).
# Use when only app code + poppler/pymupdf changed — avoids 400MB+ torch re-download.
FROM learning-buddy-c2-buddy-api:latest

ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV HF_ENDPOINT=https://hf-mirror.com

RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null \
    || true

RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir 'pymupdf>=1.24.0' 'pdf2image>=1.17.0' 'Pillow>=10.0.0'

COPY app ./app
COPY data ./data
COPY scripts ./scripts

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
    CMD curl -sf http://127.0.0.1:8100/api/v1/system/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8100"]
