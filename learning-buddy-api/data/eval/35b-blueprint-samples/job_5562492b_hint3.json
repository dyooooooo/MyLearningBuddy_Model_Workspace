          "content": {
            "text": "1.1 集合初步",
            "caption": null,
            "table_html": null,
            "latex": null,
            "asset_key": null,
            "asset_url": null
          }
        },
        {
          "id": "p9_b4",
          "kind": "text",
          "zone": "main",
