          },
          {
            "kind": "text",
            "raw": " x ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "组成的集合称为一个闭区间，记作",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " [a,b].\n\n",
            "latex": null,
