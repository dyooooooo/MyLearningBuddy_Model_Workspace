      "anchor_id": "p11_b7",
      "figure_group_id": null,
      "content": {
        "text": null,
        "table": null,
        "equation": {
          "latex": "A=\\{x \\mid x \\text{ 满足性质 } p\\}",
          "fallback_text": "A={x | x 满足性质 p}"
        },
        "figure": null,
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "math",
            "raw": "A=\\{x \\mid x \\text{ 满足性质 } p\\}",
            "latex": "A=\\{x \\mid x \\text{ 满足性质 } p\\}",
            "valid": true
