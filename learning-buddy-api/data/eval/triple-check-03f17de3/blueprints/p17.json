            "valid": false
          },
          {
            "kind": "math",
            "raw": " B ⊆ A ∪ B = {1,2,3}",
            "latex": "B ⊆ A \\cup B = \\{ 1 , 2 , 3 \\}",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "，所以",
            "latex": null,
            "valid": false
