      "anchor_id": "p11_b8",
      "figure_group_id": "p11_fg1",
      "content": {
        "text": null,
        "caption": null,
        "table_html": null,
        "latex": "A=\\{x \\mid x \\text{ 满足性质 } p\\}.",
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "math",
            "raw": "A=\\{x \\mid x \\text{ 满足性质 } p\\}.",
            "latex": "A=\\{x \\mid x \\text{ 满足性质 } p\\}.",
            "valid": true
          }
        ]
