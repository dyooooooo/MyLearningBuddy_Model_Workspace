    {
      "id": "p11_b8",
      "kind": "text",
      "zone": "main",
      "role": "body",
      "bbox": [
        330.0,
        860.0,
        900.0,
        925.0
      ],
      "anchor_id": "p11_b9",
      "figure_group_id": "p11_fg1",
      "content": {
        "text": "这种表示集合的方法叫做描述法. 例如，方程 x^2-3x+2=0 的所有解组成的集合可以表示为 {x | x^2-3x+2=0}. 又如，函数 y=x 图像上的所有点组成的集合可以表示为 {(x,y) | y=x}.",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "这种表示集合的方法叫做描述法",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ". ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "例如，方程",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " x^2-3x+2=0 ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "的所有解组成的集合可以表示为",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " {x | x^2-3x+2=0}. ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "又如，函数",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " y=x ",
            "latex": "y = x",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "图像上的所有点组成的集合可以表示为",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " {(x,y) | y=x}.",
            "latex": "\\{ ( x , y ) | y = x \\} .",
            "valid": true
          }
        ]
      }
    },
