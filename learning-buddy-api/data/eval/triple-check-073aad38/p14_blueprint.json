      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "由此，对第(3)(4)组集合，C=D 成立；而对第(1)(2)组集合，C=D 不成立. 为此，我们引入真子集的概念.",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "由此，对第",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "(3)(4)",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "组集合，",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": "C=D ",
            "latex": "C = D",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "成立；而对第",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "(1)(2)",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "组集合，",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": "C=D ",
            "latex": "C = D",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "不成立",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ". ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "为此，我们引入真子集的概念",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ".",
            "latex": null,
            "valid": false
          }
        ]
