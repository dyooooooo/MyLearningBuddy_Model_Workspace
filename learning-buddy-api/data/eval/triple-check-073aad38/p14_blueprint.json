      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "(1) A⊆A;",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": null
      }
    },
