      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "(2) 若 A⊆B 且 B⊆A，则 A=B;",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "(2) ",
