      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "表 1-1 常用数集的符号",
        "caption": "表 1-1 常用数集的符号",
        "table_html": "<table>\n  <tr>\n    <th>数集</th>\n    <th>符号</th>\n  </tr>\n  <tr>\n    <td>自然数集</td>\n    <td>N</td>\n  </tr>\n  <tr>\n    <td>整数集</td>\n    <td>Z</td>\n  </tr>\n  <tr>\n    <td>有理数集</td>\n    <td>Q</td>\n  </tr>\n  <tr>\n    <td>实数集</td>\n    <td>R</td>\n  </tr>\n</table>",
        "latex": null,
