      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "“集合中所有元素具有的共同特征”是指：\n(1) 在该集合中的元素都具有这个特征；\n(2) 不在该集合中的元素不具有这个特征.",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": null
      }
    }
