            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "，记作",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " A∩B(",
            "latex": "A \\cap B (  ",
