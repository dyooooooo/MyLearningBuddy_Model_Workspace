            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "又属于集合",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " B ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "的所有元素组成的集合，叫做集合",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " A ",
            "latex": null,
            "valid": false
          },
          {
