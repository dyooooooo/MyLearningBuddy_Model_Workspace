        900.0
      ],
      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "定义 由既属于集合 A 又属于集合 B 的所有元素组成的集合，叫做集合 A 与 B 的交集(intersection)，记作 A∩B(读作“A 交 B”)，即",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "定义",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": " ",
