      "content": {
        "text": "康托(G. Cantor, 1845—1918)，德国数学家，集合论创始人.",
        "caption": "康托(G. Cantor, 1845—1918)，德国数学家，集合论创始人.",
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": null
