        465.0
      ],
      "anchor_id": null,
      "figure_group_id": null,
      "content": {
        "text": "我们经常需要把满足一定要求或具有一定特征的对象放在一起或归为一类. 例如:\n(1) 申辉中学高一(1)班的全体学生;\n(2) 所有不大于 100 的自然数;\n(3) 直线 l 上的所有点;\n(4) 不等式 2x+1≤0 的所有解;\n(5) 太阳系的所有行星.",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "我们经常需要把满足一定要求或具有一定特征的对象放在一起或归为一类",
