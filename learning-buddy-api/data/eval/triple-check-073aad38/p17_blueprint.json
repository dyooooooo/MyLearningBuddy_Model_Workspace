            "raw": " A = {1, 2}, ",
            "latex": "A = \\{ 1 ,  2 \\} ,",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "求所有满足",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " A ∪ B = {1, 2, 3} ",
            "latex": "A \\cup B = \\{ 1 ,  2 ,  3 \\}",
