            "valid": false
          },
          {
            "kind": "text",
            "raw": "的元素，不会影响",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " A ∪ B ",
            "latex": "A \\cup B",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "的结果",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ". ",
