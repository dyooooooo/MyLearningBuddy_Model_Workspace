      "content": {
        "text": "例 11 已知集合 A = {1, 2}, 求所有满足 A ∪ B = {1, 2, 3} 的集合 B.",
        "caption": null,
        "table_html": null,
        "latex": null,
        "asset_key": null,
        "asset_url": null,
        "text_segments": [
          {
            "kind": "text",
            "raw": "例",
            "latex": null,
            "valid": false
