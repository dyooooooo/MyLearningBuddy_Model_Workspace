            "raw": "A ∩ B ",
            "latex": "A \\cap B",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "表示二元一次方程组的所有解组成的集合",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ". ",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": "它可以理解为两个一次函数",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
            "raw": " y = -2x + 5 ",
            "latex": "y = - 2 x + 5",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "与",
            "latex": null,
            "valid": false
          },
          {
            "kind": "math",
