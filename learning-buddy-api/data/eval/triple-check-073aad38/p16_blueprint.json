            "latex": "y = - \\frac{3}{2} x + 4",
            "valid": true
          },
          {
            "kind": "text",
            "raw": "的图像的交点组成的集合",
            "latex": null,
            "valid": false
          },
          {
            "kind": "text",
            "raw": ".",
            "latex": null,
            "valid": false
          }
        ]
      }
