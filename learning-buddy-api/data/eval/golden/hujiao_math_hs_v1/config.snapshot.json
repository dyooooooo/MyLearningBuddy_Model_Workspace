{
  "refine_mode": "skip",
  "refine_parallel": 1,
  "geometry": {
    "page_w": 1000.0,
    "wide_min": 380.0,
    "aside_max_width": 320.0,
    "min_gutter": 18.0,
    "full_width_ratio": 0.72,
    "min_y_overlap": 18.0,
    "min_companion_width": 200.0,
    "aside_left_x1_max": 280.0,
    "aside_right_x0_min": 680.0,
    "figure_y_tolerance": 35.0
  },
  "patterns": {
    "chapter": "^第[０-９0-9一二三四五六七八九十百千]+章\\s*.+",
    "lesson": "^[０-９0-9]+[\\.．][０-９0-9]+\\s+\\S",
    "fig_label": "^图[\\s　]*[０-９0-9]+[\\.．-][０-９0-9\\.．-]*",
    "fig_ref": "如图\\s*[\\d\\.．-]+|图\\s*[\\d\\.．-]+\\s*所示",
    "solution_lead": "^解\\s*$|^解\\s*([（(][0-9０-９].*)$",
    "toc_trailing_page": "^(.+?)\\s+(\\d+)\\s*$",
    "chapter_toc": "^第\\s*[0-9０-９一二三四五六七八九十百]+\\s*章",
    "toc_section": "^\\\\?\\*?(\\d+(?:\\.\\d+)+)\\b",
    "toc_summary": "^(内容提要|复习题|习题|小结)",
    "toc_titles": [
      "目录",
      "目 录"
    ],
    "pedagogy_patterns": {},
    "figure_caption": null
  },
  "features": {
    "columns": "triple_slots",
    "running_header_footer": true,
    "aside": "both",
    "toc_style": "text_list",
    "figure_policy": "strict_label",
    "math_density": "high",
    "cover_pages": [
      1,
      2
    ]
  },
  "zones": {
    "aside_left_x1_max": 280,
    "aside_right_x0_min": 680
  },
  "figure_group": {
    "y_tolerance": 35
  }
}
